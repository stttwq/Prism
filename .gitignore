# Build outputs
**/target/
**/bin/
**/obj/
**/.vs/
*.user
*.suo
**/*_wpftmp.csproj

# Runtime caches / data produced by prism-core
**/data/index.bin
**/data/history-v1.json
**/data/history-v1.corrupt-*.json
**/data/broker.jsonl*
**/debug/data/
**/release/data/

# .NET / NuGet
*.nupkg
project.lock.json
packages/

# Python
**/__pycache__/
*.py[cod]
*.egg-info/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Shell misdirects (e.g. PowerShell $null → file)
/$null
$null

# Local tooling / agent state (not product source)
.claude/
.agents/
.codex/
.cursor/
.idea/
.vscode/

# Trellis local runtime / developer id (journals under workspace are tracked)
.trellis/.runtime/
.trellis/.cache/
.trellis/.backup-*/
.trellis/worktrees/
.trellis/.developer
# Keep session journals & index; ignore other workspace clutter if any
.trellis/workspace/**
!.trellis/workspace/*/
!.trellis/workspace/*/journal*.md
!.trellis/workspace/*/index.md
