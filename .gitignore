# Build outputs
**/target/
**/bin/
**/obj/
**/.vs/
*.user
*.suo
**/*_wpftmp.csproj

# Runtime caches / data produced by prism-core
**/data/index.bin
**/data/history-v1.json
**/data/history-v1.corrupt-*.json
**/data/broker.jsonl*
**/debug/data/
**/release/data/

# .NET / NuGet
*.nupkg
project.lock.json
packages/

# Python
**/__pycache__/
*.py[cod]
*.egg-info/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Shell misdirects (e.g. PowerShell $null → file)
/$null
$null

# Local tooling / agent state (not product source)
.claude/
.agents/
.codex/
.cursor/
.idea/
.vscode/

# Trellis local runtime / developer id (journals under workspace are tracked)
.trellis/.runtime/
.trellis/.cache/
.trellis/.backup-*/
.trellis/worktrees/
.trellis/.developer
# Keep session journals & index; ignore other workspace clutter if any
.trellis/workspace/**
!.trellis/workspace/*/
!.trellis/workspace/*/journal*.md
!.trellis/workspace/*/index.md

# Diagnostic probe scratch: the reusable .ps1 probes are tracked, but their
# build output and run logs are not. Committing binaries here once let a stale
# copy shadow a fresh build for days (see docs/排查踩坑记录.md).
artifacts/*/TabProbe/bin/
artifacts/*/TabProbe/obj/
artifacts/**/*.log
artifacts/**/probe-output.txt
artifacts/g4-test-build/*.exe
artifacts/g4-test-build/*.dll
artifacts/g4-test-build/*.pdb
artifacts/g4-test-build/Prism.*.json

# Debug symbols never ship with the installer payload.
dist/*.pdb
