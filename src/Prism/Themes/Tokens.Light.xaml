<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 浅色主题令牌（frontend-spec.md §5，截图实测近似值） -->
    <SolidColorBrush x:Key="BgWindow" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgItemSelected" Color="#ECEEF0"/>
    <SolidColorBrush x:Key="TextQuery" Color="#37393E"/>
    <SolidColorBrush x:Key="TextPlaceholder" Color="#B8BCC2"/>
    <SolidColorBrush x:Key="TextTitle" Color="#303237"/>
    <SolidColorBrush x:Key="TextMatch" Color="#1E7AD4"/>
    <SolidColorBrush x:Key="TextSubtitle" Color="#9B9FA6"/>
    <SolidColorBrush x:Key="Divider" Color="#E8EAEC"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#D4D7DA"/>

    <sys:Double x:Key="WindowWidth">660</sys:Double>
    <sys:Double x:Key="RadiusWindow">10</sys:Double>
    <sys:Double x:Key="HeaderHeight">68</sys:Double>
    <sys:Double x:Key="FontSizeQuery">26</sys:Double>
    <sys:Double x:Key="FontSizePlaceholder">22</sys:Double>
    <sys:Double x:Key="ItemHeight">62</sys:Double>
    <sys:Double x:Key="IconSizeItem">32</sys:Double>
    <sys:Double x:Key="FontSizeTitle">17</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">13</sys:Double>
    <sys:Double x:Key="FontSizeHotkeyHint">15</sys:Double>
    <sys:Double x:Key="ActionItemHeight">44</sys:Double>
    <sys:Double x:Key="IconSizeAction">20</sys:Double>
    <sys:Double x:Key="FontSizeAction">16</sys:Double>
    <sys:Double x:Key="FontSizeSectionLabel">15</sys:Double>
    <sys:Double x:Key="PadX">20</sys:Double>
    <FontFamily x:Key="AppFontFamily">微软雅黑, Segoe UI</FontFamily>
</ResourceDictionary>
