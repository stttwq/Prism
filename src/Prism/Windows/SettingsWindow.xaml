<Window x:Class="Prism.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Prism.Controls"
        Title="Prism 设置"
        Width="640" Height="480"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F7F8FA"
        FontFamily="微软雅黑, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SettingsNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#37393E"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="20,10,12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E3E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D3D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#37393E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>

        <Style x:Key="SettingsPrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#1E7AD4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#EEF0F3" Padding="0,16,0,16">
            <StackPanel>
                <TextBlock Text="设置"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#303237"
                           Margin="20,0,12,16"/>
                <Button Content="常规"
                        Command="{Binding SelectTabCommand}" CommandParameter="0"
                        Style="{StaticResource SettingsNavButton}"/>
                <Button Content="网页搜索"
                        Command="{Binding SelectTabCommand}" CommandParameter="1"
                        Style="{StaticResource SettingsNavButton}"/>
                <Button Content="关于"
                        Command="{Binding SelectTabCommand}" CommandParameter="2"
                        Style="{StaticResource SettingsNavButton}"/>
            </StackPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 常规 -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsGeneralTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="常规" FontSize="20" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,18"/>

                    <TextBlock Text="呼出快捷键" FontSize="13" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,8"/>

                    <RadioButton Content="双击 Ctrl（默认）"
                                 IsChecked="{Binding IsDoubleCtrlMode, Mode=TwoWay}"
                                 GroupName="HotkeyMode"
                                 FontSize="13" Foreground="#37393E"
                                 Margin="0,0,0,8"/>

                    <RadioButton Content="自定义组合键"
                                 IsChecked="{Binding IsComboMode, Mode=TwoWay}"
                                 GroupName="HotkeyMode"
                                 FontSize="13" Foreground="#37393E"
                                 Margin="0,0,0,8"/>

                    <StackPanel Margin="22,0,0,16"
                                IsEnabled="{Binding IsComboEditorEnabled}">
                        <TextBlock Text="点击下方框并按下组合键（如 Alt+Space）"
                                   FontSize="12" Foreground="#9B9FA6"
                                   Margin="0,0,0,6"/>
                        <controls:HotkeyRecorderBox Value="{Binding ComboHotkey, Mode=TwoWay}"/>
                    </StackPanel>

                    <Border Height="1" Background="#E8EAEC" Margin="0,4,0,16"/>

                    <TextBlock Text="启动" FontSize="13" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,8"/>
                    <CheckBox Content="开机时自动启动 Prism"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}"
                              FontSize="13" Foreground="#37393E"
                              Margin="0,0,0,16"/>

                    <Border Height="1" Background="#E8EAEC" Margin="0,4,0,16"/>

                    <TextBlock Text="搜索" FontSize="13" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,8"/>
                    <CheckBox Content="启用拼音搜索"
                              IsChecked="{Binding PinyinEnabled, Mode=TwoWay}"
                              FontSize="13" Foreground="#37393E"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="使用成功操作历史优化同级排序"
                              IsChecked="{Binding HistoryEnabled, Mode=TwoWay}"
                              FontSize="13" Foreground="#37393E"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="从文件管理器呼出时限定当前目录（含子目录，Ctrl+G 切换）"
                              IsChecked="{Binding CurrentDirectorySearchEnabled, Mode=TwoWay}"
                              FontSize="13" Foreground="#37393E"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="识别 Windows 资源管理器当前目录（实验性 / 需兼容矩阵验收）"
                              IsChecked="{Binding ExplorerHostIntegrationEnabled, Mode=TwoWay}"
                              FontSize="13" Foreground="#37393E"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="识别 Directory Opus 当前目录（实验性 / 需兼容矩阵验收）"
                              IsChecked="{Binding DirectoryOpusHostIntegrationEnabled, Mode=TwoWay}"
                              FontSize="13" Foreground="#37393E"
                              Margin="0,0,0,10"/>
                    <Button Content="清除使用历史"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource SettingsActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"/>

                    <Border Height="1" Background="#E8EAEC" Margin="0,4,0,16"/>

                    <TextBlock Text="压缩程序" FontSize="13" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,6"/>
                    <TextBlock Text="压缩为 ZIP 时优先使用此程序（留空则自动探测 7-Zip，再回退 Windows 内置）："
                               FontSize="12" Foreground="#9B9FA6"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ZipProgram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="6,4"
                             Margin="0,0,0,16"/>

                    <Border Height="1" Background="#E8EAEC" Margin="0,4,0,16"/>

                    <TextBlock Text="数据目录" FontSize="13" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,6"/>
                    <TextBlock Text="索引与设置存放位置（安装目录不可写时自动改到用户数据夹）："
                               FontSize="12" Foreground="#9B9FA6"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DataDir}"
                               FontSize="13" Foreground="#37393E"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 网页搜索 -->
            <Grid Grid.Row="0"
                  Visibility="{Binding IsWebTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="网页搜索" FontSize="20" FontWeight="SemiBold"
                               Foreground="#303237" Margin="0,0,0,8"/>
                    <TextBlock Text="在搜索框输入「关键词 + 空格 + 内容」即可用默认浏览器打开对应网站。URL 中用 {q} 代表搜索词。"
                               FontSize="12" Foreground="#9B9FA6" TextWrapping="Wrap"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Engines}"
                          SelectedItem="{Binding SelectedEngine, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#E8EAEC"
                          BorderThickness="1"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="关键词"
                                            Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"/>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            Width="100"/>
                        <DataGridTextColumn Header="URL 模板（含 {q}）"
                                            Binding="{Binding UrlTemplate, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="添加" Command="{Binding AddEngineCommand}"
                            Style="{StaticResource SettingsActionButton}" Margin="0,0,8,0"/>
                    <Button Content="删除选中" Command="{Binding RemoveEngineCommand}"
                            Style="{StaticResource SettingsActionButton}" Margin="0,0,8,0"/>
                    <Button Content="恢复预设" Command="{Binding ResetEnginesCommand}"
                            Style="{StaticResource SettingsActionButton}"/>
                </StackPanel>
            </Grid>

            <!-- 关于 -->
            <StackPanel Grid.Row="0"
                        Visibility="{Binding IsAboutTab, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="关于" FontSize="20" FontWeight="SemiBold"
                           Foreground="#303237" Margin="0,0,0,18"/>
                <TextBlock Text="Prism" FontSize="28" FontWeight="SemiBold"
                           Foreground="#1E7AD4" Margin="0,0,0,8"/>
                <TextBlock FontSize="13" Foreground="#37393E" Margin="0,0,0,4"
                           Text="{Binding Version, StringFormat=版本 {0}, Mode=OneWay}"/>
                <TextBlock Text="Windows 快速搜索 / 启动工具，替代 Listary 的日常核心用法。"
                           FontSize="13" Foreground="#9B9FA6"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="界面文字均为中文。后端 prism-core 负责索引与搜索，前端负责窗口与托盘。"
                           FontSize="12" Foreground="#9B9FA6"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 状态行 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="#1E7AD4"
                       TextWrapping="Wrap"
                       MinHeight="18"
                       Margin="0,12,0,8"/>

            <!-- 底部按钮 -->
            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="保存"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource SettingsPrimaryButton}"
                        Margin="8,0,0,0"
                        IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Content="关闭"
                        Click="OnCloseClick"
                        Style="{StaticResource SettingsActionButton}"
                        IsCancel="True"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
