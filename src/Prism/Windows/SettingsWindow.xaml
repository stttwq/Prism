<Window x:Class="Prism.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Prism.Controls"
        Title="Prism 设置"
        Width="640" Height="480"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgSettingsPage}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SettingsNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="20,10,12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSettingsNavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BgSettingsInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSettingsInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>

        <Style x:Key="SettingsPrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource TextMatch}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- 引擎管理大按钮：单行紧凑（图标 + 标题），描述移入 ToolTip（问题3） -->
        <Style x:Key="SettingsEngineCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSettingsInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSettingsInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMatch}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 带边框输入框：替代默认白色系统 TextBox，深浅色都成立 -->
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgSettingsInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextQuery}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSettingsInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource TextMatch}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题化勾选框：默认 Aero2 白底方块在深色页面上刺眼 -->
        <!-- 深色 ComboBox（动作快捷键行选动作用；默认白底系统样式与页面割裂） -->
        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSettingsNavHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="Background" Value="{DynamicResource BgSettingsInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSettingsInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bd"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <!-- 命中整个框即展开（ClickMode=Press），不让 ToggleButton 挡内容 -->
                            <ToggleButton x:Name="Toggle"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{DynamicResource TextSubtitle}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource BgSettingsInput}"
                                        BorderBrush="{DynamicResource BorderSettingsInput}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMatch}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    CornerRadius="3"
                                    Background="{DynamicResource BgSettingsInput}"
                                    BorderBrush="{DynamicResource BorderSettingsInput}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 3,7 L 6.5,10.5 L 13,3.5"
                                      Stroke="{DynamicResource TextMatch}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextMatch}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Circle"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource BgSettingsInput}"
                                    BorderBrush="{DynamicResource BorderSettingsInput}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Dot"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource TextMatch}"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource TextMatch}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgSettingsNav}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="SettingsDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BgSettingsInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
            <Setter Property="RowBackground" Value="{DynamicResource BgSettingsInput}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgSettingsAltRow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource SettingsDataGridColumnHeaderStyle}"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          Margin="4,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgItemSelected}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource TextQuery}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgItemSelected}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 编辑态 TextBox：基于 SettingsTextBoxStyle，仅调紧凑 Padding，
             双击编辑格生成的内部 TextBox 拿到主题色，深色下不再露系统白底。 -->
        <Style x:Key="SettingsDataGridEditTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource SettingsTextBoxStyle}">
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- 设置页分节折叠器（问题4B 整页折叠）：字形箭头旋转 + SemiBold 标题。 -->
        <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextTitle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalContentAlignment="Left"
                                          Padding="0,4"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Arrow"
                                               Text="&#xE76C;"
                                               FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSubtitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{DynamicResource BgSettingsNav}" Padding="0,16,0,16">
            <StackPanel>
                <TextBlock Text="设置"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTitle}"
                           Margin="20,0,12,16"/>
                <Button Content="常规"
                        Command="{Binding SelectTabCommand}" CommandParameter="0"
                        Style="{StaticResource SettingsNavButton}"/>
                <Button Content="快速访问"
                        Command="{Binding SelectTabCommand}" CommandParameter="1"
                        Style="{StaticResource SettingsNavButton}"/>
                <Button Content="网页搜索"
                        Command="{Binding SelectTabCommand}" CommandParameter="2"
                        Style="{StaticResource SettingsNavButton}"/>
                <Button Content="过滤触发"
                        Command="{Binding SelectTabCommand}" CommandParameter="3"
                        Style="{StaticResource SettingsNavButton}"/>
                <Button Content="关于"
                        Command="{Binding SelectTabCommand}" CommandParameter="4"
                        Style="{StaticResource SettingsNavButton}"/>
            </StackPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 常规 -->
            <ScrollViewer Grid.Row="0"
                          Style="{StaticResource PrismScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsGeneralTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="常规" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,18"/>

                    <TextBlock Text="启动" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,8"/>
                    <CheckBox Content="开机时自动启动 Prism"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              Margin="0,0,0,16"/>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4,0,16"/>

                    <TextBlock Text="搜索" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,8"/>
                    <CheckBox Content="启用拼音搜索"
                              IsChecked="{Binding PinyinEnabled, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="使用成功操作历史优化同级排序"
                              IsChecked="{Binding HistoryEnabled, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="从文件管理器呼出时限定当前目录（含子目录，Ctrl+G 切换）"
                              IsChecked="{Binding CurrentDirectorySearchEnabled, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="识别 Windows 资源管理器当前目录（实验性 / 需兼容矩阵验收）"
                              IsChecked="{Binding ExplorerHostIntegrationEnabled, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="识别 Directory Opus 当前目录（实验性 / 需兼容矩阵验收）"
                              IsChecked="{Binding DirectoryOpusHostIntegrationEnabled, Mode=TwoWay}"
                              Style="{StaticResource SettingsCheckBoxStyle}"
                              Margin="0,0,0,10"/>
                    <Button Content="清除使用历史"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource SettingsActionButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"/>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4,0,16"/>

                    <TextBlock Text="压缩程序" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="压缩为 ZIP 时优先使用此程序（留空则自动探测 7-Zip，再回退 Windows 内置）："
                               FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ZipProgram, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             Margin="0,0,0,16"/>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4,0,16"/>

                    <TextBlock Text="数据目录" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="索引与设置存放位置（安装目录不可写时自动改到用户数据夹）："
                               FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DataDir}"
                               FontSize="13" Foreground="{DynamicResource TextQuery}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 快速访问（2026-08-21 设想）：呼出键（全局）+ 动作快捷键（窗口级）+ 文件别名。 -->
            <ScrollViewer Grid.Row="0"
                          Style="{StaticResource PrismScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsQuickAccessTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="快速访问" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="呼出键全局生效；动作快捷键与别名只在 Prism 搜索窗口打开时生效，不与其他软件抢键位。"
                               FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <TextBlock Text="呼出快捷键（全局）" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,8"/>

                    <RadioButton Content="双击 Ctrl（默认）"
                                 IsChecked="{Binding IsDoubleCtrlMode, Mode=TwoWay}"
                                 GroupName="HotkeyMode"
                                 Style="{StaticResource SettingsRadioButtonStyle}"
                                 Margin="0,0,0,8"/>
                    <RadioButton Content="自定义组合键"
                                 IsChecked="{Binding IsComboMode, Mode=TwoWay}"
                                 GroupName="HotkeyMode"
                                 Style="{StaticResource SettingsRadioButtonStyle}"
                                 Margin="0,0,0,8"/>

                    <StackPanel Margin="22,0,0,16"
                                IsEnabled="{Binding IsComboEditorEnabled}">
                        <TextBlock Text="点击下方框并按下组合键（如 Alt+Space）"
                                   FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                   Margin="0,0,0,6"/>
                        <controls:HotkeyRecorderBox Value="{Binding ComboHotkey, Mode=TwoWay}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4,0,16"/>

                    <Expander Style="{StaticResource SettingsExpanderStyle}"
                              IsExpanded="True"
                              Header="动作快捷键（搜索窗口内生效）"
                              Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="默认不绑定任何动作。点「添加动作」逐个添加：先选动作，再点右侧框录制组合键，搜索窗口打开时按下即对当前选中项执行。方向键、Enter、Esc、Ctrl+G、Ctrl+数字保留给导航，不可绑定。"
                                       FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ActionHotkeys}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                                      ItemsSource="{Binding AvailableActionsView}"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding Id, Mode=TwoWay}"
                                                      Width="170"
                                                      VerticalAlignment="Center">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSubtitle}"
                                                                           Padding="8,4,0,2"/>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       FontFamily="{DynamicResource IconFontFamily}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextSubtitle}"
                                                                       VerticalAlignment="Center"
                                                                       Width="16" TextAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextQuery}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSubtitle}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="120"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding ScopeText}"
                                                       FontSize="11" Foreground="{DynamicResource TextSubtitle}"
                                                       Grid.Column="1" VerticalAlignment="Center"
                                                       Margin="10,1,0,0"/>
                                            <controls:HotkeyRecorderBox Value="{Binding Value, Mode=TwoWay}"
                                                                        Width="200"
                                                                        Grid.Column="3"/>
                                            <Button Content="删除"
                                                    Command="{Binding DataContext.RemoveActionHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SettingsActionButton}"
                                                    Padding="10,2,10,2"
                                                    Grid.Column="4" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="＋ 添加动作"
                                    Command="{Binding AddActionHotkeyCommand}"
                                    Style="{StaticResource SettingsActionButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"/>
                        </StackPanel>
                    </Expander>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4,0,16"/>

                    <Expander Style="{StaticResource SettingsExpanderStyle}"
                              IsExpanded="False"
                              Header="暂存区"
                              Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="搜索窗口内按下方快捷键把选中文件扔进暂存区（搜索框下方的文件架），随时拖出到任意应用。满了自动挤掉最早加入的未标记文件。"
                                       FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="加入暂存区"
                                           FontSize="13" Foreground="{DynamicResource TextQuery}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <controls:HotkeyRecorderBox Value="{Binding StagingAddHotkey, Mode=TwoWay}"
                                                            Width="200"
                                                            Grid.Column="1"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="容量（1–32）"
                                               FontSize="13" Foreground="{DynamicResource TextQuery}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding StagingCapacityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             Width="64" Padding="8,4,8,4"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="清空录键框 = 禁用该快捷键。"
                                       FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                       Margin="0,0,0,16"/>
                        </StackPanel>
                    </Expander>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4,0,16"/>

                    <Expander Style="{StaticResource SettingsExpanderStyle}"
                              IsExpanded="False"
                              Header="文件别名"
                              Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="在搜索结果上右键「设置别名…」绑定快捷词；输入词与查询完全一致时对应文件置顶显示。"
                                       FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding AliasEntries}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="320"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     Margin="0,0,0,4">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander Style="{StaticResource SettingsExpanderStyle}"
                                                                      IsExpanded="True" Margin="0,0,0,4">
                                                                <Expander.Header>
                                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextTitle}">
                                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                                        <Run Text=" (" FontWeight="Normal" Foreground="{DynamicResource TextSubtitle}"/>
                                                                        <Run Text="{Binding ItemCount, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextSubtitle}"/>
                                                                        <Run Text=")" FontWeight="Normal" Foreground="{DynamicResource TextSubtitle}"/>
                                                                    </TextBlock>
                                                                </Expander.Header>
                                                                <ItemsPresenter/>
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0,2"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BgItemSelected}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BgItemSelected}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding WordsText}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMatch}"
                                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TargetFileName}"
                                                       FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Target.Value}"
                                                       Grid.Column="1" VerticalAlignment="Center"/>
                                            <Button Content="删除"
                                                    Command="{Binding DataContext.RemoveAliasCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SettingsActionButton}"
                                                    Padding="10,2,10,2"
                                                    Grid.Column="2" Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="（暂无别名。在搜索结果上右键即可添加。）"
                                       FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                                       Visibility="{Binding HasNoAliases, Converter={StaticResource BoolToVis}}"
                                       Margin="0,0,0,16"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 网页搜索 -->
            <Grid Grid.Row="0"
                  Visibility="{Binding IsWebTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="网页搜索" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="在搜索框输入「关键词 + 空格 + 内容」即可用默认浏览器打开对应网站。URL 中用 {q} 代表搜索词。"
                               FontSize="12" Foreground="{DynamicResource TextSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource SettingsDataGridStyle}"
                          ItemsSource="{Binding Engines}"
                          SelectedItem="{Binding SelectedEngine, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="13"
                          MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="关键词"
                                            Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"
                                            EditingElementStyle="{StaticResource SettingsDataGridEditTextBoxStyle}"/>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            Width="100"
                                            EditingElementStyle="{StaticResource SettingsDataGridEditTextBoxStyle}"/>
                        <DataGridTextColumn Header="URL 模板（含 {q}）"
                                            Binding="{Binding UrlTemplate, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            EditingElementStyle="{StaticResource SettingsDataGridEditTextBoxStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,12">
                    <Button Command="{Binding AddEngineCommand}"
                            Style="{StaticResource SettingsEngineCardButton}"
                            ToolTip="新增一行空白引擎"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextAlignment="Center"
                                       Width="16"/>
                            <TextBlock Text="添加引擎" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveEngineCommand}"
                            Style="{StaticResource SettingsEngineCardButton}"
                            ToolTip="移除列表中选中的引擎"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextAlignment="Center"
                                       Width="16"/>
                            <TextBlock Text="删除选中" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResetEnginesCommand}"
                            Style="{StaticResource SettingsEngineCardButton}"
                            ToolTip="还原全部内置引擎">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextAlignment="Center"
                                       Width="16"/>
                            <TextBlock Text="恢复预设" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="在线联想" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTitle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox Content="启用在线联想（仅内置 Bing / 百度 / Google，默认关闭）"
                                  IsChecked="{Binding SuggestionsEnabled, Mode=TwoWay}"
                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE7B3;"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSubtitle}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Width="18" Height="18"
                                   TextAlignment="Center"
                                   ToolTip="查询词和联想结果不写入历史或日志。单次请求 800ms 超时，断网或失败时静默回退直接搜索。自定义引擎不支持联想。favicon 图标联网获取需在保存引擎时单独授权，与联想开关相互独立。"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 过滤触发词 -->
            <Grid Grid.Row="0"
                  Visibility="{Binding IsFiltersTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="过滤触发词" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="在搜索框输入「关键词 + 空格 + 内容」即可按扩展名或路径过滤文件。类型选 ext 按扩展名过滤，选 path 按路径过滤。"
                               FontSize="12" Foreground="{DynamicResource TextSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource SettingsDataGridStyle}"
                          ItemsSource="{Binding FilterTriggers}"
                          SelectedItem="{Binding SelectedFilterTrigger, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="13"
                          MinHeight="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="关键词"
                                            Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"
                                            EditingElementStyle="{StaticResource SettingsDataGridEditTextBoxStyle}"/>
                        <DataGridTextColumn Header="类型"
                                            Binding="{Binding FilterType, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80"
                                            EditingElementStyle="{StaticResource SettingsDataGridEditTextBoxStyle}"/>
                        <DataGridTextColumn Header="说明"
                                            Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            EditingElementStyle="{StaticResource SettingsDataGridEditTextBoxStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,12">
                    <Button Command="{Binding AddFilterTriggerCommand}"
                            Style="{StaticResource SettingsEngineCardButton}"
                            ToolTip="新增一行空白触发词"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextAlignment="Center"
                                       Width="16"/>
                            <TextBlock Text="添加触发词" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveFilterTriggerCommand}"
                            Style="{StaticResource SettingsEngineCardButton}"
                            ToolTip="移除列表中选中的触发词"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextAlignment="Center"
                                       Width="16"/>
                            <TextBlock Text="删除选中" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResetFilterTriggersCommand}"
                            Style="{StaticResource SettingsEngineCardButton}"
                            ToolTip="还原全部预设触发词">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextAlignment="Center"
                                       Width="16"/>
                            <TextBlock Text="恢复预设" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>

            <!-- 关于 -->
            <StackPanel Grid.Row="0"
                        Visibility="{Binding IsAboutTab, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="关于" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTitle}" Margin="0,0,0,18"/>
                <TextBlock Text="Prism" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMatch}" Margin="0,0,0,8"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource TextQuery}" Margin="0,0,0,4"
                           Text="{Binding Version, StringFormat=版本 {0}, Mode=OneWay}"/>
                <TextBlock Text="Windows 快速搜索 / 启动工具，替代 Listary 的日常核心用法。"
                           FontSize="13" Foreground="{DynamicResource TextSubtitle}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="界面文字均为中文。后端 prism-core 负责索引与搜索，前端负责窗口与托盘。"
                           FontSize="12" Foreground="{DynamicResource TextSubtitle}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 状态行 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="{DynamicResource TextMatch}"
                       TextWrapping="Wrap"
                       MinHeight="18"
                       Margin="0,12,0,8"/>

            <!-- 底部按钮 -->
            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="保存"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource SettingsPrimaryButton}"
                        Margin="8,0,0,0"
                        IsDefault="True"/>
                <Button DockPanel.Dock="Right"
                        Content="关闭"
                        Click="OnCloseClick"
                        Style="{StaticResource SettingsActionButton}"
                        IsCancel="True"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
