<Window x:Class="Prism.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Prism.Controls"
        Width="660" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" Focusable="True"
        WindowStartupLocation="Manual"
        Opacity="0">
    <!-- 第四步：输入 + 结果列表；动作面板后续步骤 -->
    <Border Background="{DynamicResource BgWindow}"
            CornerRadius="10"
            Margin="20"
            Effect="{DynamicResource WindowShadow}">
        <Border.Resources>
            <!-- Blur 过大吃 GPU/系统显存；24 在观感与开销间更平衡 -->
            <DropShadowEffect x:Key="WindowShadow"
                              BlurRadius="24" Opacity="0.20"
                              ShadowDepth="6" Direction="270"
                              Color="#000000"
                              RenderingBias="Performance"/>
        </Border.Resources>
        <StackPanel>
            <controls:SearchHeader x:Name="Header"/>
            <!-- 输入区与列表间 1px 分隔线（Results 时显示） -->
            <Border x:Name="Divider"
                    Height="1"
                    Background="{DynamicResource Divider}"
                    Visibility="Collapsed"/>
            <controls:ResultList x:Name="Results"
                                 Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
