<Window x:Class="Prism.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Prism.Controls"
        Width="620" SizeToContent="Height"
        Background="{DynamicResource BgWindow}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" Focusable="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        Opacity="0">
    <!-- A1①（去分层窗口）：不再 AllowsTransparency——窗口即卡片本体（620 = 原卡片宽），
         整窗 DWM 硬件合成，圆角/阴影交 DWM（Services/DwmWindowEffects.cs + 下面的
         WindowChrome 保留 DWM 帧位取阴影）。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="0">
        <!-- 主卡片：窗口背景即卡片背景；1px Divider 边框保留（DWM 自带边框已在
             DwmWindowEffects 里隐藏）；圆角与列表溢出裁剪均由 DWM 窗口遮罩承担。 -->
        <Border x:Name="Card"
                Background="{DynamicResource BgWindow}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel>
                <controls:SearchHeader x:Name="Header"/>
                <!-- 范围降级提示（识别失败 / 宿主关闭 / 路径无效时说明已回到全局） -->
                <TextBlock x:Name="ScopeNotice"
                           Margin="20,0,20,8"
                           FontSize="13"
                           FontFamily="{DynamicResource AppFontFamily}"
                           Foreground="{DynamicResource TextSubtitle}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <Border x:Name="Divider"
                        Height="1"
                        Background="{DynamicResource Divider}"
                        Visibility="Collapsed"/>
                <!-- 面板容器：Results / Actions 互斥；高度动画在 code-behind -->
                <Grid x:Name="PanelHost" ClipToBounds="True">
                    <controls:ResultList x:Name="Results"
                                         Visibility="Collapsed"/>
                    <controls:ActionPanel x:Name="Actions"
                                          Visibility="Collapsed"/>
                </Grid>
                <!-- Actions 态 / 全局错误提示（Results 空态仍用 ResultList.StatusMessage） -->
                <TextBlock x:Name="ActionStatus"
                           Margin="20,8,20,12"
                           FontSize="13"
                           FontFamily="{DynamicResource AppFontFamily}"
                           Foreground="{DynamicResource TextSubtitle}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- PinButton：内嵌卡片右上角（去透明后无法悬挂在圆角外，见 A1①） -->
        <controls:PinButton x:Name="Pin"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Panel.ZIndex="10"/>
    </Grid>
</Window>
