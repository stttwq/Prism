<UserControl x:Class="Prism.Controls.ResultList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ListBox x:Name="List"
                 Style="{DynamicResource ResultListBoxStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectionChanged="OnSelectionChanged"
                 PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                 MouseRightButtonUp="OnMouseRightButtonUp"
                 MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="62" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="IconImage"
                               Grid.Column="0"
                               Width="32" Height="32"
                               Margin="20,0,14,0"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <!-- Title 文本由 code-behind ApplyMatchSpans 写入 Inlines，
                                 不再绑定 Text——OneWay 绑定会在容器回收时重新推送 Text，
                                 清掉 Inlines 导致与手动构建的高亮 Run 叠加。 -->
                            <TextBlock x:Name="TitleBlock"
                                       FontSize="17"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       Foreground="{DynamicResource TextTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="13"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       Foreground="{DynamicResource TextSubtitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="HotkeyHint"
                                   Grid.Column="2"
                                   FontSize="15"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextSubtitle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Left"
                   Margin="20,8,20,12"
                   FontSize="13"
                   FontFamily="{DynamicResource AppFontFamily}"
                   Foreground="{DynamicResource TextSubtitle}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
