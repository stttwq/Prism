<UserControl x:Class="Prism.Controls.SearchHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="68">
    <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Actions 状态：大号灰字"动作" -->
        <TextBlock x:Name="ModeLabel"
                   Grid.Column="0"
                   Text="动作"
                   FontSize="22"
                   FontFamily="{DynamicResource AppFontFamily}"
                   Foreground="{DynamicResource TextPlaceholder}"
                   VerticalAlignment="Center"
                   Margin="0,0,14,0"
                   Visibility="Collapsed"/>

        <!-- Actions 状态：1px 竖分隔线 -->
        <Border x:Name="ModeDivider"
                Grid.Column="1"
                Width="1"
                Height="28"
                Background="{DynamicResource Divider}"
                VerticalAlignment="Center"
                Margin="0,0,14,0"
                Visibility="Collapsed"/>

        <!-- 输入框 + 占位文字 -->
        <Grid Grid.Column="2">
            <TextBlock x:Name="Placeholder"
                       Text="搜索应用和文件"
                       Foreground="{DynamicResource TextPlaceholder}"
                       FontSize="{DynamicResource FontSizePlaceholder}"
                       FontFamily="{DynamicResource AppFontFamily}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
            <TextBox x:Name="QueryBox"
                     Style="{DynamicResource QueryTextBoxStyle}"
                     VerticalAlignment="Stretch"
                     TextChanged="OnQueryTextChanged"
                     PreviewKeyDown="OnQueryPreviewKeyDown"/>
        </Grid>

        <!-- 右侧淡灰放大镜装饰 -->
        <TextBlock Grid.Column="3"
                   Text="&#xE721;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="22"
                   Foreground="{DynamicResource TextPlaceholder}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Opacity="0.7"/>
    </Grid>
</UserControl>
