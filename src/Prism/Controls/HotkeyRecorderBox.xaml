<UserControl x:Class="Prism.Controls.HotkeyRecorderBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             MinHeight="32"
             GotKeyboardFocus="OnGotKeyboardFocus"
             LostKeyboardFocus="OnLostKeyboardFocus"
             PreviewKeyDown="OnPreviewKeyDown"
             MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border x:Name="Chrome"
            Background="{DynamicResource BgSettingsInput}"
            BorderBrush="{DynamicResource BorderSettingsInput}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,6">
        <Grid>
            <TextBlock x:Name="Display"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontFamily="{DynamicResource AppFontFamily}"
                       Foreground="{DynamicResource TextSubtitle}"
                       Text="点击此处，然后按下组合键"/>
        </Grid>
    </Border>
</UserControl>
