<UserControl x:Class="Prism.Controls.ActionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Prism.Models">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type models:ActionItem}">
            <Grid Height="44">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                <Setter Property="Height" Value="32"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 节标题：灰色小字，无图标 -->
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding Label}"
                           FontSize="{DynamicResource FontSizeSectionLabel}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           Foreground="{DynamicResource TextSubtitle}"
                           VerticalAlignment="Bottom"
                           Margin="20,0,20,6"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 普通动作行 -->
                <TextBlock x:Name="Glyph"
                           Grid.Column="0"
                           Text="{Binding IconGlyph}"
                           FontFamily="{DynamicResource IconFontFamily}"
                           FontSize="16"
                           Foreground="{DynamicResource TextTitle}"
                           Width="20" Height="20"
                           Margin="20,0,14,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IconGlyph}" Value="">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           FontSize="{DynamicResource FontSizeAction}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           Foreground="{DynamicResource TextTitle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2"
                           Text="&#xE76C;"
                           FontFamily="{DynamicResource IconFontFamily}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSubtitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSubmenu}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ListBox x:Name="List"
             Style="{DynamicResource ResultListBoxStyle}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             SelectionChanged="OnSelectionChanged"
             MouseDoubleClick="OnDoubleClick">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnItemPreviewMouseLeftButtonUp"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="0">
                                <Grid>
                                    <!-- 双层高亮（与 Styles.xaml 的 ResultListBoxStyle 同构）：
                                         选中与悬停各占一层、由各自唯一的触发器持有动画。 -->
                                    <Border x:Name="HighlightSelected"
                                            Background="{DynamicResource BgItemSelected}"
                                            Opacity="0"/>
                                    <Border x:Name="HighlightHover"
                                            Background="{DynamicResource BgItemSelected}"
                                            Opacity="0"/>
                                    <ContentPresenter/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HighlightSelected"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.10"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HighlightSelected"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.10"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HighlightHover"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.8" Duration="0:0:0.10"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HighlightHover"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.10"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
    </ListBox>
</UserControl>
